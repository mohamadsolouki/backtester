generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TRADER
  REVIEWER
}

enum SessionName {
  PRE_MARKET
  OPEN
  MIDDAY
  CLOSE
  POST_MARKET
}

enum OpportunityStatus {
  PLANNED
  WATCHING
  TAKEN
  SKIPPED
  NOT_FORMED
  REVIEWED
}

enum Grade {
  A_PLUS
  A
  A_MINUS
  B_PLUS
  B
  C
  D
  F
}

enum EntryType {
  E1
  E2
  E3
}

enum EntryStatus {
  TAKEN
  SKIPPED
  NOT_FORMED
  WAITING
}

enum SkipReason {
  FAR_FROM_EMA
  UNSAFE_STOP
  LOW_VOLUME
  RANGE
  NEWS
  PSYCHOLOGY
  OTHER
}

enum TradeDirection {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
  SCRATCH
}

enum ScreenshotKind {
  CONTEXT
  ENTRY
  EXIT
  REVIEW
  PLAYBOOK
}

enum ReportPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(TRADER)
  timezone      String    @default("Asia/Dubai")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  opportunities         Opportunity[]
  trades                Trade[]
  sopDocuments          SOPDocument[]
  playbookSetups        PlaybookSetup[]
  reviews               Review[]
  reports               Report[]
  importBatches         ImportBatch[]
  contextTagDefinitions ContextTagDefinition[]
  ruleBreakDefinitions  RuleBreakDefinition[]
  settings              UserSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Opportunity {
  id                String            @id @default(cuid())
  userId            String
  ticker            String
  pair              String?
  setupName         String
  market            String            @default("Futures")
  bias              String
  primaryContext    String
  sessionName       SessionName
  status            OpportunityStatus @default(PLANNED)
  confirmationCount Int               @default(0)
  grade             Grade             @default(C)
  plannedAt         DateTime          @default(now())
  takenAt           DateTime?
  riskReward        Decimal?          @db.Decimal(8, 2)
  qualityScore      Int               @default(0)
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextTags ContextTag[]
  entries     Entry[]
  trade       Trade?
  screenshots Screenshot[]
  review      Review?

  @@index([userId, plannedAt])
  @@index([ticker, setupName])
  @@index([grade, status])
}

model ContextTag {
  id            String  @id @default(cuid())
  opportunityId String
  name          String
  enabled       Boolean @default(false)
  weight        Int     @default(1)
  note          String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, name])
}

model Entry {
  id            String      @id @default(cuid())
  opportunityId String
  type          EntryType
  status        EntryStatus @default(WAITING)
  skipReason    SkipReason?
  entryPrice    Decimal?    @db.Decimal(12, 4)
  stopPrice     Decimal?    @db.Decimal(12, 4)
  targetPrice   Decimal?    @db.Decimal(12, 4)
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, type])
}

model Trade {
  id            String         @id @default(cuid())
  userId        String
  opportunityId String?        @unique
  ticker        String
  direction     TradeDirection
  status        TradeStatus    @default(CLOSED)
  sessionName   SessionName
  quantity      Decimal?       @db.Decimal(12, 4)
  entryPrice    Decimal        @db.Decimal(12, 4)
  exitPrice     Decimal?       @db.Decimal(12, 4)
  rMultiple     Decimal        @db.Decimal(8, 2)
  pnl           Decimal        @db.Decimal(12, 2)
  fees          Decimal        @default(0) @db.Decimal(12, 2)
  openedAt      DateTime
  closedAt      DateTime?
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  ruleBreaks  RuleBreak[]
  screenshots Screenshot[]
  review      Review?

  @@index([userId, openedAt])
  @@index([ticker, sessionName])
}

model RuleBreak {
  id          String   @id @default(cuid())
  tradeId     String
  rule        String
  severity    Int      @default(1)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model Screenshot {
  id            String         @id @default(cuid())
  userId        String?
  opportunityId String?
  tradeId       String?
  playbookId    String?
  kind          ScreenshotKind
  url           String
  caption       String?
  createdAt     DateTime       @default(now())

  opportunity Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  trade       Trade?         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  playbook    PlaybookSetup? @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([opportunityId, tradeId, playbookId])
}

model Review {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String?  @unique
  tradeId       String?  @unique
  score         Int
  lesson        String   @db.Text
  actionItem    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  trade       Trade?       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model SOPDocument {
  id        String   @id @default(cuid())
  userId    String
  title     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions SOPVersion[]

  @@index([userId, active])
}

model SOPVersion {
  id          String   @id @default(cuid())
  sopId       String
  version     String
  content     Json
  changeLog   String?  @db.Text
  publishedAt DateTime @default(now())

  sop SOPDocument @relation(fields: [sopId], references: [id], onDelete: Cascade)

  @@unique([sopId, version])
}

model PlaybookSetup {
  id                String   @id @default(cuid())
  userId            String
  name              String
  context           String
  validConditions   String[]
  invalidConditions String[]
  entryLogic        String   @db.Text
  exitLogic         String   @db.Text
  notes             String?  @db.Text
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  screenshots Screenshot[]

  @@index([userId, active])
}

model Report {
  id        String       @id @default(cuid())
  userId    String
  period    ReportPeriod
  startsAt  DateTime
  endsAt    DateTime
  metrics   Json
  notes     String?      @db.Text
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period, startsAt])
}

model ContextTagDefinition {
  id        String   @id @default(cuid())
  userId    String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model RuleBreakDefinition {
  id        String   @id @default(cuid())
  userId    String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  riskPerTrade   Decimal  @default(0.75) @db.Decimal(5, 2)
  maxDailyLoss   Decimal  @default(1500) @db.Decimal(12, 2)
  maxOpenRisk    Decimal  @default(1.5) @db.Decimal(5, 2)
  maxTrades      Int      @default(4)
  minR           Decimal  @default(1.5) @db.Decimal(5, 2)
  theme          String   @default("light")
  onboardingSeen Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ImportBatch {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  fileType  String
  rowCount  Int
  validRows Int
  errorRows Int
  mapping   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
